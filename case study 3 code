import java.util.*;

class MetroBFS {
    int V;
    List<List<Integer>> adj;

    MetroBFS(int v) {
        V = v;
        adj = new ArrayList<>();
        for (int i = 0; i < V; i++) adj.add(new ArrayList<>());
    }

    void addEdge(int u, int v) {
        adj.get(u).add(v);
        adj.get(v).add(u);   // undirected
    }

    int[] bfs(int source) {
        boolean[] visited = new boolean[V];
        int[] dist = new int[V];
        Arrays.fill(dist, -1);

        Queue<Integer> queue = new LinkedList<>();
        visited[source] = true;
        dist[source] = 0;
        queue.add(source);

        while (!queue.isEmpty()) {
            int u = queue.poll();
            System.out.println("Visiting: " + (char)('A' + u));

            for (int neighbor : adj.get(u)) {
                if (!visited[neighbor]) {
                    visited[neighbor] = true;
                    dist[neighbor] = dist[u] + 1;
                    queue.add(neighbor);
                }
            }
        }
        return dist;   // dist[i] = min stops from source to node i
    }

    void printShortestPath(int[] dist, int src, int dest) {
        System.out.println("Min stops from " + (char)('A'+src) +
                           " to " + (char)('A'+dest) +
                           " = " + dist[dest]);
    }
}
