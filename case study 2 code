class BTreeNode {
    int[] keys;
    int t, n;          // min degree, current key count
    BTreeNode[] children;
    boolean leaf;

    BTreeNode(int t, boolean leaf) {
        this.t = t; this.leaf = leaf;
        keys = new int[2 * t - 1];
        children = new BTreeNode[2 * t];
        n = 0;
    }
}

class BTree {
    BTreeNode root;
    int t;

    BTree(int t) { this.t = t; root = new BTreeNode(t, true); }

    // Search for key k starting from node x
    BTreeNode search(BTreeNode x, int k) {
        int i = 0;
        while (i < x.n && k > x.keys[i]) i++;
        if (i < x.n && k == x.keys[i]) return x;
        if (x.leaf) return null;
        return search(x.children[i], k);
    }

    void insert(int k) {
        BTreeNode r = root;
        if (r.n == 2 * t - 1) {      // Root is full — split it
            BTreeNode s = new BTreeNode(t, false);
            root = s;
            s.children[0] = r;
            splitChild(s, 0, r);
            insertNonFull(s, k);
        } else {
            insertNonFull(r, k);
        }
    }

    void insertNonFull(BTreeNode x, int k) {
        int i = x.n - 1;
        if (x.leaf) {
            while (i >= 0 && k < x.keys[i]) {
                x.keys[i + 1] = x.keys[i]; i--;
            }
            x.keys[i + 1] = k; x.n++;
        } else {
            while (i >= 0 && k < x.keys[i]) i--;
            i++;
            if (x.children[i].n == 2 * t - 1) {
                splitChild(x, i, x.children[i]);
                if (k > x.keys[i]) i++;
            }
            insertNonFull(x.children[i], k);
        }
    }

    // Split full child x.children[i] (y) of node x
    void splitChild(BTreeNode x, int i, BTreeNode y) {
        BTreeNode z = new BTreeNode(t, y.leaf);
        z.n = t - 1;
        // Copy right half of y to z
        for (int j = 0; j < t - 1; j++)
            z.keys[j] = y.keys[j + t];
        if (!y.leaf)
            for (int j = 0; j < t; j++)
                z.children[j] = y.children[j + t];
        y.n = t - 1;
        // Shift x's children right to make room for z
        for (int j = x.n; j >= i + 1; j--)
            x.children[j + 1] = x.children[j];
        x.children[i + 1] = z;
        // Lift median key of y to x
        for (int j = x.n - 1; j >= i; j--)
            x.keys[j + 1] = x.keys[j];
        x.keys[i] = y.keys[t - 1];
        x.n++;
    }
}
